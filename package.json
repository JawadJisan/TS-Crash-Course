{
  "name": "typescript-crash-course",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "typescript-learning-path/projects/*"
  ],
  "scripts": {
    "lesson": "tsx",
    "typecheck": "tsc -p tsconfig.curriculum.json --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
